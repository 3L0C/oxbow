(library
 (name ocdwm_protocol)
 (public_name ocdwm.protocol)
 (libraries wayland)
 (modules
  river_input_management_v1_client
  river_input_management_v1_proto
  river_layer_shell_v1_client
  river_layer_shell_v1_proto
  river_libinput_config_v1_client
  river_libinput_config_v1_proto
