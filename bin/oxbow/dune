(executable
 (name main)
 (public_name oxbow)
 (package oxbow)
 (libraries
  oxbow.core
  oxbow.runtime
  oxbow.state
  dune-build-info
  cmdliner
  eio_main
  logs
  logs.fmt
  fmt
  fmt.tty))

(rule
 (with-stdout-to
  oxbow.1
  (run %{exe:main.exe} --help=groff)))

(install
 (section man)
 (package oxbow)
 (files oxbow.1))
