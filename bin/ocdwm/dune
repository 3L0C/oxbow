(executable
 (name main)
 (public_name ocdwm)
 (package ocdwm)
 (libraries
  ocdwm.core
  ocdwm.runtime
  ocdwm.state
  dune-build-info
  cmdliner
  eio_main
  logs
  logs.fmt
  fmt
  fmt.tty))

(rule
 (with-stdout-to
  ocdwm.1
  (run %{exe:main.exe} --help=groff)))

(install
 (section man)
 (package ocdwm)
 (files ocdwm.1))
