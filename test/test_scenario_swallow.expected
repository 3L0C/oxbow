== window rules add --app-id=^foot$ --swallow=terminal ==
manage:clear_focus(seat0)
manage:op_end(seat0)
render:set_presentation_mode

== foot arrives ==
manage:get_node(foot)
manage:set_capabilities(foot)
manage:propose_dimensions(foot, 1872x1032)
manage:set_tiled(foot)
manage:use_ssd(foot)
manage:inform_unmaximized(foot)
manage:inform_not_fullscreen(foot)
manage:inform_resize_end(foot)
manage:focus_window(seat0, foot)
manage:op_end(seat0)
manage:focus_window(seat0, foot)
manage:op_end(seat0)
render:set_borders(foot, w=4, rgba=7f7f7f7f b4b4b4b4 cacacaca ffffffff)
render:set_position(foot, 24, 24)
render:show(foot)
render:set_clip_box(foot, 0, 0, 0x0)
render:set_content_clip_box(foot, 0, 0, 0x0)
render:place_top(foot)
render:set_presentation_mode
render:place_top(foot)
render:set_presentation_mode

== mpv arrives - swallows foot ==
manage:get_node(mpv)
manage:set_capabilities(mpv)
manage:propose_dimensions(mpv, 1872x1032)
manage:set_tiled(mpv)
manage:use_ssd(mpv)
manage:inform_unmaximized(mpv)
manage:inform_not_fullscreen(mpv)
manage:inform_resize_end(mpv)
manage:focus_window(seat0, mpv)
manage:op_end(seat0)
manage:focus_window(seat0, mpv)
manage:op_end(seat0)
render:set_borders(mpv, w=4, rgba=98989898 bbbbbbbb 6c6c6c6c ffffffff)
render:set_borders(foot, w=4, rgba=72727272 71717171 69696969 ffffffff)
render:set_position(mpv, 24, 24)
render:show(mpv)
render:set_clip_box(mpv, 0, 0, 0x0)
render:set_content_clip_box(mpv, 0, 0, 0x0)
render:hide(foot)
render:place_top(mpv)
render:set_presentation_mode
render:place_top(mpv)
render:set_presentation_mode

