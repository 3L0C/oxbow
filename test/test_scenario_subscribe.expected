== spawn emacs ==
manage:get_node(emacs)
manage:set_capabilities(emacs, caps=0x4)
manage:propose_dimensions(emacs, 1872x1032)
manage:set_tiled(emacs, edges=0xf)
manage:use_ssd(emacs)
manage:inform_unmaximized(emacs)
manage:inform_not_fullscreen(emacs)
manage:inform_resize_end(emacs)
manage:focus_window(seat0, emacs)
manage:op_end(seat0)
manage:focus_window(seat0, emacs)
manage:op_end(seat0)
render:set_borders(emacs, edges=0xf, w=4, rgba=7f7f7f7f b4b4b4b4 cacacaca ffffffff)
render:set_position(emacs, 24, 24)
render:show(emacs)
render:set_clip_box(emacs, 0, 0, 0x0)
render:set_content_clip_box(emacs, 0, 0, 0x0)
render:place_top(emacs)
render:set_presentation_mode(FAKE-1, vsync)
render:place_top(emacs)
render:set_presentation_mode(FAKE-1, vsync)

