== spawn kitty ==
manage:get_node(kitty)
manage:set_capabilities(kitty, caps=0x4)
manage:propose_dimensions(kitty, 833x332)
manage:set_tiled(kitty, edges=0xf)
manage:use_ssd(kitty)
manage:inform_unmaximized(kitty)
manage:inform_not_fullscreen(kitty)
manage:inform_resize_end(kitty)
manage:propose_dimensions(emacs, 833x332)
manage:propose_dimensions(firefox, 833x332)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:set_borders(kitty, edges=0xf, w=4, rgba=7f7f7f7f b4b4b4b4 cacacaca ffffffff)
render:set_borders(emacs, edges=0xf, w=4, rgba=72727272 71717171 69696969 ffffffff)
render:set_position(kitty, 1063, 374)
render:show(kitty)
render:set_clip_box(kitty, 0, 0, 0x0)
render:set_content_clip_box(kitty, 0, 0, 0x0)
render:set_position(firefox, 1063, 724)
render:place_top(firefox)
render:place_top(mpv)
render:place_top(emacs)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
render:place_top(firefox)
render:place_top(mpv)
render:place_top(emacs)
render:place_top(kitty)
