== check resize drag min hint: setup ==
manage:get_node(inkscape)
manage:set_capabilities(inkscape, caps=0x4)
manage:propose_dimensions(inkscape, 1872x507)
manage:set_tiled(inkscape, edges=0xf)
manage:use_ssd(inkscape)
manage:inform_unmaximized(inkscape)
manage:inform_not_fullscreen(inkscape)
manage:inform_resize_end(inkscape)
manage:focus_window(seat0, inkscape)
manage:op_end(seat0)
manage:focus_window(seat0, inkscape)
manage:op_end(seat0)
