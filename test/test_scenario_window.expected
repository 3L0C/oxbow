manage:propose_dimensions(kitty, 960x540)
manage:set_tiled(kitty, edges=0x0)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:set_position(kitty, 480, 270)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)

== stale report arrives twice ==
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)

== float ack arrives ==
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)

== client resizes, then returns to an old ask ==
manage:propose_dimensions(kitty, 800x600)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
manage:propose_dimensions(kitty, 1872x1032)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
manage:focus_window(seat0, kitty)
manage:op_end(seat0)
render:set_position(kitty, 48, 48)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)
render:place_top(kitty)
render:set_presentation_mode(FAKE-1, vsync)

== close kitty ==
manage:destroy(kitty)
manage:destroy(kitty)
manage:clear_focus(seat0)
manage:op_end(seat0)
manage:clear_focus(seat0)
manage:op_end(seat0)
render:set_presentation_mode(FAKE-1, vsync)
render:set_presentation_mode(FAKE-1, vsync)
